# OpenAI-compatible LLM endpoint. Never commit a populated .env file.
SAAS_AGENT_LLM_BASE_URL=https://provider.example/v1
SAAS_AGENT_LLM_API_KEY=replace-me
SAAS_AGENT_LLM_MODEL=model-name

# Runtime limits.
SAAS_AGENT_MAX_STEPS=80
SAAS_AGENT_LLM_API_TIMEOUT=600
SAAS_AGENT_LLM_STEP_TIMEOUT=150
SAAS_AGENT_LLM_MAX_COMPLETION_TOKENS=8192

# App-aware behavior.
SAAS_AGENT_PROMPT_MODE=routing_trimmed
SAAS_AGENT_TOOL_MODE=disabled
SAAS_AGENT_LOOP_GUARD=warn
SAAS_AGENT_LOOP_GUARD_WARN=3
SAAS_AGENT_LOOP_GUARD_STOP=8

# Write capabilities remain off unless explicitly enabled.
SAAS_AGENT_BIGCAPITAL_WRITE_MODE=off
SAAS_AGENT_TWENTY_WRITE_MODE=off

# Optional local observability. Dumps may contain sensitive task content.
# SAAS_AGENT_RECORD_LLM_MESSAGES=1
# SAAS_AGENT_MSG_DUMP_DIR=message-dumps
# SAAS_AGENT_DUMP_LLM_REQUEST=request-dumps/first-request.json
# SAAS_AGENT_TMP=/tmp/saas-agent

# Optional app credentials. Prefer per-run task/tool context over process-wide
# environment variables. Never commit real values.
# SAAS_AGENT_BASEROW_EMAIL=replace-me@example.invalid
# SAAS_AGENT_BASEROW_PASSWORD=replace-me
# SAAS_AGENT_BIGCAPITAL_EMAIL=replace-me@example.invalid
# SAAS_AGENT_BIGCAPITAL_PASSWORD=replace-me
# SAAS_AGENT_METABASE_USERNAME=replace-me@example.invalid
# SAAS_AGENT_METABASE_PASSWORD=replace-me
# SAAS_AGENT_BASEROW_PG_DATABASE=replace-me
# SAAS_AGENT_BASEROW_PG_USERNAME=replace-me
# SAAS_AGENT_BASEROW_PG_PASSWORD=replace-me
# SAAS_AGENT_OPENPROJECT_USERNAME=replace-me
# SAAS_AGENT_OPENPROJECT_PASSWORD=replace-me
# SAAS_AGENT_OPENPROJECT_API_KEY=replace-me
